# Copy this file to Backend/.env and fill in real values.
# Backend/.env is git-ignored — never commit real secrets.

# --- Core ---
NODE_ENV=production
BACKEND_PORT=4000

# --- Database (MongoDB Atlas connection string) ---
# Get this from Atlas: Database > Connect > Drivers. Must include your DB user/password
# (URL-encode special characters in the password) and usually ?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/libreport?retryWrites=true&w=majority
DB_NAME=libreport

# --- Auth ---
# Generate with: npm run token:secret  (inside Backend/)
JWT_SECRET=

# --- Default admin bootstrap ---
# Created automatically on first boot if no admin exists yet. In production the
# server refuses to start without ADMIN_PASSWORD set (no silent weak default).
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_ID=03-2324-032224
ADMIN_NAME=Librarian
ADMIN_PASSWORD=

# Keep this unset/false in production once your first admin exists.
ALLOW_ADMIN_SIGNUP=false

# --- CORS ---
# Comma-separated list of allowed frontend origins. Leave unset only if the
# frontend is served same-origin behind the same Nginx (recommended setup).
# Example if frontend is on a different origin: https://app.example.com
CORS_ORIGIN=

# --- Optional: business rules ---
FINE_RATE_PER_DAY=1
LOAN_DAYS_DEFAULT=28

# --- Optional: Web Push notifications (leave blank to disable) ---
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:admin@yourdomain.com
